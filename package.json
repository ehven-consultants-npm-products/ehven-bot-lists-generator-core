{
  "name": "@ehven/bot-lists-generator-core",
  "version": "0.1.0-dev.0",
  "description": "Explicit public inventories and portable crawler, discovery, feed and disclosure generators.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.19.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.mts",
      "import": "./src/index.mjs"
    },
    "./publication": {
      "types": "./src/publication.d.mts",
      "import": "./src/publication.mjs"
    },
    "./metadata": {
      "types": "./src/metadata.d.mts",
      "import": "./src/metadata.mjs"
    },
    "./integrations": {
      "types": "./src/integrations.d.mts",
      "import": "./src/integrations.mjs"
    }
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "src/index.d.mts",
    "src/index.mjs",
    "src/integrations.d.mts",
    "src/integrations.mjs",
    "src/metadata.d.mts",
    "src/metadata.mjs",
    "src/publication.d.mts",
    "src/publication.mjs",
    "src/validation.mjs"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "node --test",
    "check:types": "tsc --noEmit --strict --module NodeNext --moduleResolution NodeNext --target ES2022 type-tests/consumer.mts",
    "check": "node --test && npm run check:types && node scripts/check-package.mjs",
    "release:prepare": "node scripts/release.mjs prepare"
  },
  "devDependencies": {
    "@astrojs/rss": "4.0.19",
    "typescript": "6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ehven-consultants-npm-products/ehven-bot-lists-generator-core.git"
  },
  "author": "Gilad Ehven",
  "homepage": "https://github.com/ehven-consultants-npm-products/ehven-bot-lists-generator-core#readme",
  "bugs": {
    "url": "https://github.com/ehven-consultants-npm-products/ehven-bot-lists-generator-core/issues"
  },
  "keywords": [
    "robots.txt",
    "llms.txt",
    "security.txt",
    "humans.txt",
    "rss",
    "sitemap",
    "publication"
  ]
}
